{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlowAudio",
  "version": "0.3.0",
  "identifier": "com.kernullist.glowaudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GlowAudio Desktop",
        "width": 920,
        "height": 600,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0d0e12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "kernullist",
    "copyright": "Copyright (c) 2026 kernullist",
    "shortDescription": "Smart Windows audio router",
    "longDescription": "GlowAudio Desktop - control real Windows playback devices, auto-switch on game launch, and cycle devices with a global hotkey HUD.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
